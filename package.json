{
  "name": "escucha-loja",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "data:buildings": "node scripts/build-buildings.mjs",
    "data:overture-canton": "uvx overturemaps download --bbox=-79.60,-4.56,-79.05,-3.62 -f geojson --type=building -o scripts/.cache/loja-buildings-canton.geojson",
    "data:buildings-canton": "node scripts/build-buildings.mjs scripts/.cache/loja-buildings-canton.geojson --con-cabeceras",
    "data:tiles": "./scripts/build-tiles.sh",
    "data:verify": "node scripts/verify-pmtiles.mjs",
    "data:parroquias": "node scripts/build-parroquias.mjs",
    "data:territorio": "./scripts/build-territorio.sh",
    "data:verify-territorio": "node scripts/verify-territorio.mjs",
    "data:all": "npm run data:buildings && npm run data:tiles"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/blob": "^2.8.0",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.0",
    "google-auth-library": "^11.1.0",
    "jose": "^6.2.12",
    "lucide-react": "^0.400.0",
    "maplibre-gl": "^6.9.1",
    "openai": "^7.20.0",
    "pmtiles": "^4.5.0",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "pbf": "^5.1.2",
    "playwright-core": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
